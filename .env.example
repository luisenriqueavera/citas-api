DB_HOST=localhost
DB_PORT=3306
DB_NAME=citas_fcv_training
DB_USER=citas_app
DB_PASSWORD=CHANGE_ME
JWT_ACCESS_SECRET=CHANGE_ME_MIN_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_MIN_32_CHARS
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
FRONTEND_ORIGIN=http://localhost:5173
# Optional: n8n webhook URL for appointment status change notifications (S5/S6).
# Leave empty to keep the notifier disabled (no-op).
APPOINTMENT_WEBHOOK_URL=
# Optional but recommended once APPOINTMENT_WEBHOOK_URL is set: shared secret sent as the
# X-Webhook-Secret header on every outbound call. Configure the same value as the n8n
# "Webhook Secret Compartido" (Header Auth) credential on WF-002's webhook node, otherwise
# anyone who discovers the n8n URL can trigger patient emails with an arbitrary payload.
APPOINTMENT_WEBHOOK_SECRET=
