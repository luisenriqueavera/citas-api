    {
      "id": "37219ef9-fd81-42c7-8f07-a2e299df9daa",
      "name": "Enviar notificacion por Gmail",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [1440, 0],
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "={{ $json.patientEmail }}",
        "subject": "={{ $json.subject }}",
        "emailType": "html",
        "message": "={{ $json.htmlBody }}",
        "options": { "appendAttribution": false }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueErrorOutput",
      "notesInFlow": false,
      "notes": "Requiere credencial Gmail OAuth2 propia (configurar en n8n, nunca en este JSON)."
    },
    {
      "id": "b99e3d2f-7044-43e9-b87a-53fe6fc093b2",
