{
  "name": "WF-002 - Notificacion de cambio de estado",
  "nodes": [
    {
      "id": "cfded250-eb2a-4e01-8e4c-e5b7813bb8bd",
      "name": "Webhook cambio de estado",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.2,
      "position": [0, 0],
      "parameters": { "httpMethod": "POST", "path": "appointment-status-notification", "responseMode": "responseNode" }
    },
    {
      "id": "47f9cf23-fa79-415a-8498-cd8cc911ebd5",
      "name": "Validar payload requerido",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [240, 0],
      "parameters": {
        "conditions": {
          "combinator": "and",
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            { "leftValue": "={{ $json.body.appointmentId }}", "operator": { "type": "string", "operation": "notEmpty" }, "rightValue": "" },
            { "leftValue": "={{ $json.body.newStatus }}", "operator": { "type": "string", "operation": "notEmpty" }, "rightValue": "" },
            { "leftValue": "={{ $json.body.changeSource }}", "operator": { "type": "string", "operation": "notEmpty" }, "rightValue": "" },
            { "leftValue": "={{ $json.body.patientEmail }}", "operator": { "type": "string", "operation": "notEmpty" }, "rightValue": "" }
          ]
        }
      }
    },
    {
      "id": "7ee17b97-99aa-4c4e-9c79-d4dcced25956",
      "name": "Normalizar y clasificar evento",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [480, 0],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            { "id": "n1", "name": "appointmentId", "value": "={{ $json.body.appointmentId }}", "type": "string" },
            { "id": "n2", "name": "previousStatus", "value": "={{ $json.body.previousStatus }}", "type": "string" },
            { "id": "n3", "name": "newStatus", "value": "={{ $json.body.newStatus }}", "type": "string" },
            { "id": "n4", "name": "changeSource", "value": "={{ $json.body.changeSource }}", "type": "string" },
            { "id": "n5", "name": "reason", "value": "={{ $json.body.reason || \"\" }}", "type": "string" },
            { "id": "n6", "name": "occurredAt", "value": "={{ $json.body.occurredAt }}", "type": "string" },
            { "id": "n7", "name": "patientEmail", "value": "={{ $json.body.patientEmail }}", "type": "string" },
            { "id": "n8", "name": "patientName", "value": "={{ $json.body.patientName }}", "type": "string" },
            { "id": "n9", "name": "professionalName", "value": "={{ $json.body.professionalName }}", "type": "string" },
            { "id": "n10", "name": "specialtyName", "value": "={{ $json.body.specialtyName }}", "type": "string" },
            { "id": "n11", "name": "scheduledStartAt", "value": "={{ $json.body.scheduledStartAt }}", "type": "string" },
            {
              "id": "n12", "name": "eventType", "type": "string",
              "value": "={{ ($json.body.reason || \"\").startsWith(\"RESCHEDULE_APPROVED\") ? \"RESCHEDULE_APPROVED\" : ($json.body.reason || \"\").startsWith(\"RESCHEDULE_REJECTED\") ? \"RESCHEDULE_REJECTED\" : $json.body.newStatus === \"CANCELLED\" ? \"CANCELLED\" : $json.body.newStatus === \"APPROVED\" ? \"APPROVED\" : $json.body.newStatus === \"REJECTED\" ? \"REJECTED\" : \"UNKNOWN\" }}"
            }
          ]
        }
      }
    },
    {
      "id": "d7ec5010-bedf-442c-ada9-ad0516dca80b",
      "name": "Ramificar por tipo de evento",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.4,
      "position": [720, 0],
      "parameters": {
        "mode": "rules",
        "rules": {
          "values": [
            { "outputKey": "Cancelada", "conditions": { "combinator": "and", "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" }, "conditions": [{ "leftValue": "={{ $json.eventType }}", "operator": { "type": "string", "operation": "equals" }, "rightValue": "CANCELLED" }] } },
            { "outputKey": "Aprobada", "conditions": { "combinator": "and", "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" }, "conditions": [{ "leftValue": "={{ $json.eventType }}", "operator": { "type": "string", "operation": "equals" }, "rightValue": "APPROVED" }] } },
            { "outputKey": "Rechazada", "conditions": { "combinator": "and", "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" }, "conditions": [{ "leftValue": "={{ $json.eventType }}", "operator": { "type": "string", "operation": "equals" }, "rightValue": "REJECTED" }] } },
            { "outputKey": "ReprogramacionAprobada", "conditions": { "combinator": "and", "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" }, "conditions": [{ "leftValue": "={{ $json.eventType }}", "operator": { "type": "string", "operation": "equals" }, "rightValue": "RESCHEDULE_APPROVED" }] } },
            { "outputKey": "ReprogramacionRechazada", "conditions": { "combinator": "and", "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" }, "conditions": [{ "leftValue": "={{ $json.eventType }}", "operator": { "type": "string", "operation": "equals" }, "rightValue": "RESCHEDULE_REJECTED" }] } }
          ]
        },
        "options": { "fallbackOutput": "extra", "renameFallbackOutput": "Desconocido" }
      }
    },
    {
      "id": "5de4e431-6815-4569-ba57-c334b422761a",
      "name": "Mensaje: cancelacion",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [960, -320],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            { "id": "s1", "name": "subject", "value": "Cita cancelada - FCV", "type": "string" },
            { "id": "s2", "name": "htmlBody", "value": "={{ \"<p>Hola \" + $json.patientName + \",</p><p>Tu cita con \" + $json.professionalName + \" (\" + $json.specialtyName + \") programada para \" + $json.scheduledStartAt + \" fue <strong>cancelada</strong>.</p>\" }}", "type": "string" }
          ]
        }
      }
    },
    {
      "id": "7125384a-da24-4000-bdbf-6e2ab464155c",
      "name": "Mensaje: cita aprobada",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [960, -160],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            { "id": "s1", "name": "subject", "value": "Cita especializada aprobada - FCV", "type": "string" },
            { "id": "s2", "name": "htmlBody", "value": "={{ \"<p>Hola \" + $json.patientName + \",</p><p>Tu cita especializada con \" + $json.professionalName + \" (\" + $json.specialtyName + \") programada para \" + $json.scheduledStartAt + \" fue <strong>aprobada</strong>.</p>\" }}", "type": "string" }
          ]
        }
      }
    },
    {
      "id": "dff8669f-eb00-4567-b12d-459ef5a2c534",
      "name": "Mensaje: cita rechazada",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [960, 0],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            { "id": "s1", "name": "subject", "value": "Cita especializada rechazada - FCV", "type": "string" },
            { "id": "s2", "name": "htmlBody", "value": "={{ \"<p>Hola \" + $json.patientName + \",</p><p>Tu cita especializada con \" + $json.professionalName + \" (\" + $json.specialtyName + \") programada para \" + $json.scheduledStartAt + \" fue <strong>rechazada</strong>.\" + ($json.reason ? \" Motivo: \" + $json.reason : \"\") + \"</p>\" }}", "type": "string" }
          ]
        }
      }
    },
    {
      "id": "a14199a2-05fa-4588-adeb-82e2860cdd95",
      "name": "Mensaje: reprogramacion aprobada",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [960, 160],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            { "id": "s1", "name": "subject", "value": "Reprogramacion aprobada - FCV", "type": "string" },
            { "id": "s2", "name": "htmlBody", "value": "={{ \"<p>Hola \" + $json.patientName + \",</p><p>Tu solicitud de reprogramacion con \" + $json.professionalName + \" (\" + $json.specialtyName + \") fue <strong>aprobada</strong>. Nueva fecha: \" + $json.scheduledStartAt + \".</p>\" }}", "type": "string" }
          ]
        }
      }
    },
    {
      "id": "133f2d0d-8dd6-4cd2-a009-2a0c58f4d408",
      "name": "Mensaje: reprogramacion rechazada",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [960, 320],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            { "id": "s1", "name": "subject", "value": "Reprogramacion rechazada - FCV", "type": "string" },
            { "id": "s2", "name": "htmlBody", "value": "={{ \"<p>Hola \" + $json.patientName + \",</p><p>Tu solicitud de reprogramacion con \" + $json.professionalName + \" (\" + $json.specialtyName + \") fue <strong>rechazada</strong>.\" + ($json.reason ? \" Motivo: \" + $json.reason.replace(\"RESCHEDULE_REJECTED: \", \"\") : \"\") + \"</p>\" }}", "type": "string" }
          ]
        }
      }
    },
    {
      "id": "a58ff02a-b869-48a2-b425-e9bf74563dd5",
