    {
      "id": "d3d7a98a-3bf3-45b4-ad2c-797ac34c0c92",
      "name": "Sticky Note be454a49",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [100, 300],
      "parameters": {
        "content": "## WF-002 - Notificacion de cambio de estado\nTrigger: Webhook POST desde citas-api (AppointmentWebhookNotifier).\nEventos: cita especializada aprobada/rechazada, reprogramacion aprobada/rechazada, cancelacion.\nTrazabilidad: cada envio (exitoso, fallido o evento desconocido) se registra en la Data Table appointment_notifications_log.\nCredencial Gmail: configurar \"Gmail FCV Citas\" con OAuth propio antes de activar.",
        "color": 4
      }
    }
  ],
  "connections": {
