    "Mensaje: cancelacion": { "main": [[{ "node": "Mensaje listo para enviar", "type": "main", "index": 0 }]] },
    "Mensaje: cita aprobada": { "main": [[{ "node": "Mensaje listo para enviar", "type": "main", "index": 0 }]] },
