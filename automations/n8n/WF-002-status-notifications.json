      "typeVersion": 1.1,
      "position": [960, 620],
      "parameters": {
        "resource": "row",
        "operation": "insert",
        "dataTableId": { "__rl": true, "mode": "id", "value": "VvN1X2qxEQhdPC4Q", "cachedResultName": "appointment_notifications_log" },
